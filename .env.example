API_KEY=your-api-key-here
BASE_URL=https://chat.kiconnect.nrw/api/v1
MODEL=OpenAI-GPT-5-Mini

# Models students can pick in the sidebar, comma-separated, each "name" or
# "name|input_token_limit". The API does not report these limits; the values
# below are what KI:connect returned when sent an oversized prompt (2026-10-17).
# Leave one out and the app shows only the token count.
# Optional third field: the reasoning efforts the model accepts, "/"-separated;
# "*" marks the model's own default, which is preselected. Each model accepts a
# different set (KI:connect, 2026-10-26): Mistral only "none" and "high", Qwen
# no "high", GPT-5-Mini and GPT OSS no "xhigh". GPT-5.5's default is unknown, so
# medium is preselected. Leave the field out and the sidebar shows no effort choice.
MODELS=OpenAI-GPT-5-Mini|272000|low/medium*/high,OpenAI_GPT-5.2|272000|none*/low/medium/high/xhigh,OpenAI-GPT5.5||low/medium*/high/xhigh,OpenAI GPT OSS 120B|131072|low/medium*/high,Mistral Small 4 119B|1048576|none*/high,Qwen3.8-27b-API|262144|low/medium/xhigh*

# Warn when a single request fills more than this share of the model's input
# limit; long inputs make models read their material less reliably.
CONTEXT_WARN_SHARE=0.4

# Path to the SQLite file storing users (created automatically on first run).
USERS_DB_PATH=studybuddy_users.db